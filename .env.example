BOT_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id_here

# Optional. Set this to register slash commands to a single server instead of
# globally, which is what you want while you are working on the bot.
GUILD_ID=

# Optional. Set to true for verbose filter logging. Leave it off: with a cgb
# filter on /dmgdb random this prints three lines for every game it considers.
DEBUG=false
